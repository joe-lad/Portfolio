<div class="d-flex justify-content-between align-items-center mb-4">
  <h1>Projects</h1>
  <%= link_to "New Project", new_admin_project_path, class: "btn btn-primary" %>
</div>

<div class="row g-3">
  <% @projects.each do |project| %>
    <div class="col-12">
      <div class="card">
        <div class="card-body d-flex justify-content-between align-items-start">
          <div>
            <h5 class="card-title mb-0"><%= project.title %></h5>
            <% if project.featured? %>
              <span class="badge bg-primary mt-1">Featured</span>
            <% end %>
          </div>
          <div class="d-flex gap-2 ms-3">
            <%= link_to "Edit", edit_admin_project_path(project), class: "btn btn-sm btn-outline-secondary" %>
            <%= button_to "Delete", admin_project_path(project), method: :delete, data: { turbo_confirm: "Are you sure?" }, class: "btn btn-sm btn-danger" %>
          </div>
        </div>
      </div>
    </div>
  <% end %>
</div>