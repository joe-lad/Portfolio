<div class="d-flex justify-content-between align-items-center mb-4">
  <h1>Comments</h1>
</div>

<div class="row g-3">
  <% @comments.each do |comment| %>
    <div class="col-12">
      <div class="card">
        <div class="card-body d-flex justify-content-between align-items-start">
          <div>
            <h5 class="card-title mb-0"><%= comment.name %></h5>
            <p class="exp-company mb-1"><%= comment.email %></p>
            <p class="card-text"><%= comment.body %></p>
            <span class="badge <%= comment.approved? ? 'bg-success' : 'bg-warning text-dark' %>">
              <%= comment.approved? ? 'Approved' : 'Pending' %>
            </span>
          </div>
          <div class="d-flex flex-column gap-2 ms-3">
            <% unless comment.approved? %>
              <%= button_to "Approve", admin_comment_path(comment), method: :patch, class: "btn btn-sm btn-success" %>
            <% end %>
            <%= button_to "Delete", admin_comment_path(comment), method: :delete, data: { turbo_confirm: "Are you sure?" }, class: "btn btn-sm btn-danger" %>
          </div>
        </div>
      </div>
    </div>
  <% end %>
</div>