<%= form_with model: comment, url: comments_path, data: { turbo: false } do |f| %>
  <% if flash[:errors].present? %>
    <div class="alert mb-3" style="background-color: rgba(74, 158, 255, 0.08); border: 1px solid var(--color-accent); border-radius: 6px; padding: 1rem;">
      <p style="font-size: 0.85rem; font-weight: 600; color: var(--color-accent); margin-bottom: 0.5rem;">Please fix the following:</p>
      <ul style="margin: 0; padding-left: 1.25rem;">
        <% flash[:errors].each do |msg| %>
          <li style="font-size: 0.85rem; color: var(--color-fg-muted);"><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>
  <div class="mb-3">
    <%= f.label :name, class: "form-label" %>
    <%= f.text_field :name, class: "form-control" %>
  </div>
  <div class="mb-3">
    <%= f.label :email, class: "form-label" %>
    <%= f.email_field :email, class: "form-control" %>
  </div>
  <div class="mb-3">
    <%= f.label :body, "Comment", class: "form-label" %>
    <%= f.text_area :body, class: "form-control", rows: 4 %>
  </div>
  <%= f.submit "Submit", class: "btn btn-primary" %>
<% end %>