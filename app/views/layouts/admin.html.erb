<!DOCTYPE html>
<html>
  <head>
    <script>
      const saved = localStorage.getItem("theme")
      if (saved) document.documentElement.setAttribute("data-theme", saved)
    </script>
    <title>Admin – Portfolio</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.1/css/all.min.css" integrity="sha512-2SwdPD6INVrV/lHTZbO2nodKhrnDdJK9/kg2XD1r9uGqPo1cUbujc+IYdlYdEErWNu69gVcYgdxlmVmzTWnetw==" crossorigin="anonymous" referrerpolicy="no-referrer" />
  </head>
  <body>
    <div class="admin-layout">
      <button class="burger-btn" id="burger" aria-label="Toggle menu">
        <span></span>
        <span></span>
        <span></span>
      </button>

      <div class="sidebar-overlay" id="overlay"></div>

      <aside class="admin-sidebar">
        <div class="admin-sidebar-top">
          <h2 class="admin-brand">Admin</h2>
          <nav class="sidebar-nav">
            <%= link_to "Dashboard", admin_root_path, class: "sidebar-link #{controller_name == 'dashboard' ? 'active' : ''}" %>
            <%= link_to "Comments", admin_comments_path, class: "sidebar-link #{controller_name == 'comments' ? 'active' : ''}" %>
            <%= link_to "Projects", admin_projects_path, class: "sidebar-link #{controller_name == 'projects' ? 'active' : ''}" %>
          </nav>
        </div>
        <div class="admin-sidebar-bottom">
          <%= link_to "← Back to site", root_path, class: "social-link" %>
          <button id="theme-toggle" class="theme-toggle mt-2">🌙</button>
        </div>
      </aside>
      <main class="admin-main-content">
        <%= yield %>
      </main>
    </div>
  </body>
</html>