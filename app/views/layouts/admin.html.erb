<!DOCTYPE html>
<html>
  <head>
    <title>Admin – Portfolio</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body>
    <div class="admin-layout">
      <aside class="admin-sidebar">
        <div class="admin-sidebar-top">
          <h2 class="admin-brand">Admin</h2>
          <nav class="sidebar-nav">
            <%= link_to "Dashboard", admin_root_path, class: "sidebar-link #{controller_name == 'dashboard' ? 'active' : ''}" %>
            <%= link_to "Comments", admin_comments_path, class: "sidebar-link #{controller_name == 'comments' ? 'active' : ''}" %>
            <%= link_to "Projects", admin_projects_path, class: "sidebar-link #{controller_name == 'projects' ? 'active' : ''}" %>
          </nav>
        </div>
        <div class="admin-sidebar-bottom">
          <%= link_to "← Back to site", root_path, class: "social-link" %>
          <button id="theme-toggle" class="theme-toggle mt-2">🌙</button>
        </div>
      </aside>
      <main class="main-content">
        <% if notice %>
          <div class="alert alert-success mb-4"><%= notice %></div>
        <% end %>
        <% if alert %>
          <div class="alert alert-danger mb-4"><%= alert %></div>
        <% end %>
        <%= yield %>
      </main>
    </div>
  </body>
</html>