<div class="col-md-6" data-reveal>
  <%= link_to project_path(project), class: "card h-100 text-decoration-none text-dark", id: "hover-card"  do %>
    <div class="h-100 text-decoration-none text-dark">
      <% if project.cover_photo.attached? %>
        <%= image_tag project.cover_photo, class: "card-img-top", style: "height: 180px; object-fit: cover;" %>
      <% end %>
      <div class="card-body">
        <h5 class="card-title fw-bold"><%= project.title %></h5>
        <h6 class="card-subtitle mb-2"><%= project.subtitle %></h6>
        <p class="card-text">
          <b>Key words:</b>
          <% project.tags.each do |tag| %>
              <%= tag.name + (tag == project.tags.last ? "." : ",") %>
          <% end %>
        </p>
      </div>
    </div>
  <% end %>
</div>