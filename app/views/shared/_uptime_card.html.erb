<div class="col-md-6">
  <div class="card">
    <div class="card-body">
        <h5 class="card-title fw-bold"><%= type == "jk" ? "Portfolio" : "Github" %> uptime</h5>
        <a href=<%= type == "jk" ? "https://jknight.uk" : "https://mrshu.github.io/github-statuses" %> target="_blank" class="text-muted small">
          <%= type == "jk" ? "https://jknight.uk" : "https://mrshu.github.io/github-statuses" %>
        </a>
        <h1 id="<%= type %>-pct"></h1>
        <div id="<%= type %>-pill" class="uptime-pill uptime-pill--neutral">
          <span class="uptime-dot"></span>Loading…
        </div>
        <p class="card-text small" id="<%= type %>-meta"></p>
    </div>
  </div>
</div>